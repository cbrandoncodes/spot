# Copy this file to `.env` for local development. Never commit real credentials.
SPOT_ENVIRONMENT=local
SPOT_HTTP_ADDR=127.0.0.1:8080
SPOT_DATABASE_MAX_CONNECTIONS=10
SPOT_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
SPOT_DATABASE_RUN_MIGRATIONS=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/spot

# Generate with: openssl rand -base64 48
SPOT_AUTH_SECRET=replace-with-at-least-32-random-characters
SPOT_AUTH_BASE_URL=http://127.0.0.1:8080
SPOT_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Resend is required for email OTP delivery.
SPOT_RESEND_API_KEY=re_replace_with_resend_api_key
SPOT_EMAIL_FROM=auth@example.com

# Optional. Set both values to enable Google sign-in.
# SPOT_GOOGLE_CLIENT_ID=
# SPOT_GOOGLE_CLIENT_SECRET=

RUST_LOG=spot_backend=debug,tower_http=debug
