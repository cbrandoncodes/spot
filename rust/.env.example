# Copy this file to `.env` for local development. Never commit real credentials.
SPOT_ENVIRONMENT=local
SPOT_HTTP_ADDR=127.0.0.1:8080
SPOT_DATABASE_MAX_CONNECTIONS=10
SPOT_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
SPOT_DATABASE_RUN_MIGRATIONS=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/spot
RUST_LOG=spot_backend=debug,tower_http=debug
